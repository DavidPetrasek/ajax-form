    "form-submitter",
    "form-handler",
    "form-errors",
    "ajax"
  ],
  "author": "David Petrásek",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidPetrasek/ajax-form"
